# copy this file to .env and fill in the values before `docker compose up --build`

POSTGRES_PASSWORD=mysecretpassword

# leave DOMAIN empty for local use (http://localhost).
# set it to a real domain that points at this server to get automatic https,
# for example DOMAIN=zapier.example.com
DOMAIN=
# set this to the address the browser uses for the app. it is used in
# verification / password reset links. local: http://localhost
# server: https://zapier.example.com
PUBLIC_URL=http://localhost

# what the browser calls. local uses the direct ports, a server behind caddy
# uses the public https address for both.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_HOOKS_URL=http://localhost:3002

# change this, the default is only for local development
JWT_PASSWORD=change-me

# smtp (brevo, gmail, ...) used by the backend and the worker
SMTP_ENDPOINT=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# solana
SOL_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_DRY_RUN=true
