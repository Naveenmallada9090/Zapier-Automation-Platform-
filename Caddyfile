# Caddyfile
#
# {$DOMAIN} comes from the .env file. With a real domain Caddy fetches and
# renews a Let's Encrypt certificate automatically (ports 80 and 443 must be
# reachable). Without it, everything is served on http://localhost.
#
# One domain, three backends:
#   /api/*    -> primary-backend
#   /hooks/*  -> hooks
#   rest      -> frontend

{$DOMAIN:localhost} {
	handle /api/* {
		reverse_proxy primary-backend:3000
	}

	handle /hooks/* {
		reverse_proxy hooks:3002
	}

	handle {
		reverse_proxy frontend:3000
	}

	encode gzip
}
